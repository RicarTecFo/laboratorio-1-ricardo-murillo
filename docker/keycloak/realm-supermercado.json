  "roles": {
    "realm": [
      {
        "name": "SUPER-ADMIN-ROLE",
        "description": "Administrador: Acceso a todas las funciones.",
        "composite": true,
        "composites": {
          "client": {
            "persistencia-api": ["producto:leer", "producto:escribir", "producto:eliminar", "categoria:leer", "categoria:escribir", "categoria:eliminar"]
            }
          }
      },
      {
        "name": "USER",
        "description": "Usuario regular: Solo puede consultar productos y categorías.",
        "composite": true,
        "composites": {
          "client": {
            "persistencia-api": [
              "producto:leer",
              "categoria:leer"
              ]
          }
        }
      }
    ],
    "client": {
      "persistencia-api": [
        { "name":  "producto:leer", "description":  "Consultar productos." },
        { "name":  "producto:escribir", "description":  "Crear y actualizar productos." },
        { "name":  "producto:eliminar", "description":  "Eliminar productos." },
        { "name":  "categoria:leer", "description":  "Consultar categoria." },
        { "name":  "categoria:escribir", "description":  "Crear y actualizar categorías." },
        { "name":  "categoria:eliminar", "description":  "Eliminar categorías." }
      ]
    }
  },
  "clients": [
    {
      "clientId":"persistencia-api",
      "name": "API del lab 1.",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
